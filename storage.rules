rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isBootstrapAdmin() {
      return request.auth != null
        && request.auth.token.keys().hasAll(['email', 'email_verified'])
        && request.auth.token.email_verified == true
        && request.auth.token.email is string
        && request.auth.token.email.lower() in [
          'paylocksmith@gmail.com',
          'iaaoamar12@gmail.com',
          'liran4004@gmail.com'
        ];
    }

    function staffDoc() {
      return firestore.get(/databases/(default)/documents/staff/$(request.auth.uid));
    }

    function isAdmin() {
      return isBootstrapAdmin()
        || (
          request.auth != null
          && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
          && staffDoc().data.status == 'approved'
          && staffDoc().data.role in ['admin', 'manager']
        );
    }

    function isAssignedDriver(orderId) {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/staff/$(request.auth.uid))
        && staffDoc().data.status == 'approved'
        && staffDoc().data.role == 'driver'
        && firestore.exists(/databases/(default)/documents/orders/$(orderId))
        && firestore.get(/databases/(default)/documents/orders/$(orderId)).data.assignedDriverUid == request.auth.uid;
    }

    function canAccessOrderPhotos(orderId) {
      return isAdmin() || isAssignedDriver(orderId);
    }

    match /order-photos/{orderId}/{fileName} {
      allow read: if canAccessOrderPhotos(orderId);
      allow create, update: if canAccessOrderPhotos(orderId)
        && fileName.size() > 0
        && fileName.size() <= 180
        && request.resource.size > 0
        && request.resource.size < 8 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
      allow delete: if isAdmin();
    }

    match /order-photos/{orderId} {
      allow read: if canAccessOrderPhotos(orderId);
      allow delete: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
