{
  "name": "foam-project",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "mobile/driver",
    "mobile/ops",
    "packages/foam-staff-core"
  ],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "build": "next build && node scripts/fix-rsc-aliases.cjs",
    "test:rules": "firebase emulators:exec --project demo-foam-rules --only firestore \"node --test tests/firestore.rules.test.mjs\"",
    "test:firebase": "npm --prefix functions run build && firebase emulators:exec --project demo-foam-rules --only firestore,storage \"node --test tests/firestore.rules.test.mjs && node --test tests/storage.rules.test.mjs && node --test tests/functions-pricing.test.mjs && node --test tests/functions-reliability.test.mjs && node --test tests/functions-retention.test.mjs && node --test tests/functions-receipts.test.mjs && node --test tests/functions-charge-auth.test.mjs && node --test tests/functions-rate-limit.test.mjs && node --test tests/functions-guest-order.test.mjs\"",
    "start": "next start",
    "lint": "eslint",
    "mobile:driver": "npm run start --workspace=@foam/driver",
    "mobile:ops": "npm run start --workspace=@foam/ops",
    "mobile:driver:typecheck": "npm run typecheck --workspace=@foam/driver",
    "mobile:ops:typecheck": "npm run typecheck --workspace=@foam/ops"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/manrope": "^5.3.0",
    "@radix-ui/react-accordion": "^1.2.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-slot": "^1.3.3",
    "@stripe/react-stripe-js": "^6.12.0",
    "@stripe/stripe-js": "^9.17.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^12.19.0",
    "lucide-react": "^1.43.0",
    "next": "16.3.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/postcss": "^4",
    "@types/google.maps": "^3.66.2",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.4",
    "firebase-tools": "^15.32.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
