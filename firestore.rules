rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isCompanyOwnerEmail(email) {
      return email is string
        && email.lower() in [
          'paylocksmith@gmail.com',
          'iaaoamar12@gmail.com',
          'liran4004@gmail.com'
        ];
    }

    function isVerifiedCompanyOwner() {
      return request.auth.token.keys().hasAll(['email', 'email_verified'])
        && request.auth.token.email_verified == true
        && isCompanyOwnerEmail(request.auth.token.email);
    }

    function isAdmin() {
      return isSignedIn()
        && (
          isVerifiedCompanyOwner()
          || (
            exists(/databases/$(database)/documents/staff/$(request.auth.uid))
            && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'approved'
            && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'manager']
          )
        );
    }

    function isDriver() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'driver';
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function isAssignedDriver(order) {
      return isDriver()
        && order.assignedDriverUid is string
        && order.assignedDriverUid == request.auth.uid;
    }

    function driverStatusTransitionAllowed() {
      return request.resource.data.status == resource.data.status
        || (resource.data.status == 'new'
          && request.resource.data.status == 'confirmed')
        || (resource.data.status == 'washing'
          && request.resource.data.status == 'out_for_delivery')
        || (resource.data.status == 'out_for_delivery'
          && request.resource.data.status == 'delivered');
    }

    function driverOrderUpdateAllowed() {
      return isAssignedDriver(resource.data)
        && request.resource.data.assignedDriverUid == resource.data.assignedDriverUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'statusUpdatedAt', 'lastUpdatedBy', 'photos'
        ])
        && driverStatusTransitionAllowed()
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photos'])
          || (request.resource.data.photos is list
            && request.resource.data.photos.size() <= 30));
    }

    function orderTrackMatchesOrder(order) {
      return request.resource.data.orderId == resource.data.orderId
        && request.resource.data.status == order.status
        && request.resource.data.pickupDate == order.pickup.date
        && request.resource.data.pickupSlot == order.pickup.slot
        && request.resource.data.laundry == order.services.laundry
        && request.resource.data.dryCleaning == order.services.dryCleaning
        && request.resource.data.bagCount == order.services.bagCount
        && request.resource.data.preferences == order.preferences
        && request.resource.data.orderNotes == order.orderNotes
        && request.resource.data.pickupNotes == order.pickup.notes;
    }

    function orderTrackCreateMatchesOrder(key) {
      let orderPath = /databases/$(database)/documents/orders/$(request.resource.data.orderId);
      return request.resource.data.orderId is string
        && existsAfter(orderPath)
        && getAfter(orderPath).data.trackKey == key
        && getAfter(orderPath).data.status == request.resource.data.status
        && getAfter(orderPath).data.pickup.date == request.resource.data.pickupDate
        && getAfter(orderPath).data.pickup.slot == request.resource.data.pickupSlot
        && getAfter(orderPath).data.services.laundry == request.resource.data.laundry
        && getAfter(orderPath).data.services.dryCleaning == request.resource.data.dryCleaning
        && getAfter(orderPath).data.services.bagCount == request.resource.data.bagCount
        && getAfter(orderPath).data.preferences == request.resource.data.preferences
        && getAfter(orderPath).data.orderNotes == request.resource.data.orderNotes
        && getAfter(orderPath).data.pickup.notes == request.resource.data.pickupNotes;
    }

    function orderPromoDocumentMatches() {
      let promoPath = /databases/$(database)/documents/promoCodes/$(request.resource.data.promoCode);
      let promo = get(promoPath).data;
      return request.resource.data.promoCode is string
        && request.resource.data.promoCode.size() >= 2
        && request.resource.data.promoCode.size() <= 24
        && exists(promoPath)
        && promo.active == true
        && promo.code == request.resource.data.promoCode
        && request.resource.data.pricing.promoCode == request.resource.data.promoCode
        && request.resource.data.pricing.promoDiscountType == promo.discountType
        && request.resource.data.pricing.promoDiscountValue == promo.discountValue
        && request.resource.data.pricing.promoIncludesFee == (promo.includesFee == true)
        && (promo.limitMode != 'uses'
          || (promo.maxUses is int && promo.usedCount is int && promo.usedCount < promo.maxUses));
    }

    function orderPromoSnapshotMatches() {
      return request.resource.data.promoCode == ''
        ? request.resource.data.pricing.promoCode == ''
          && request.resource.data.pricing.promoDiscountType == null
          && request.resource.data.pricing.promoDiscountValue == null
          && request.resource.data.pricing.promoIncludesFee == false
        : orderPromoDocumentMatches();
    }

    function orderPriceSnapshotMatches() {
      let pricing = request.resource.data.pricing;
      let rates = get(/databases/$(database)/documents/config/laundryRates).data;
      return pricing is map
        && request.resource.data.tip is number
        && request.resource.data.tip >= 0
        && request.resource.data.tip <= 500
        && pricing.mode == 'weighed_at_pickup'
        && pricing.tier in ['weekly', 'standard']
        && pricing.tier == (request.resource.data.pickup.repeat == true ? 'weekly' : 'standard')
        && pricing.laundryRatePerLb > 0
        && ((pricing.tier == 'weekly' && pricing.laundryRatePerLb == rates.weeklyPerLb)
          || (pricing.tier == 'standard' && pricing.laundryRatePerLb == rates.standardPerLb))
        && pricing.deliveryFee == rates.deliveryFee
        && pricing.minimumOrder == rates.minimumOrder
        && pricing.tip == request.resource.data.tip
        && pricing.finalTotalPending == true
        && pricing.repeatDiscountEligible is bool
        && pricing.repeatDiscountPercent in [0, 10]
        && (!pricing.repeatDiscountEligible || pricing.repeatDiscountPercent == 10)
        && orderPromoSnapshotMatches();
    }

    function orderWaitingStatus() {
      return resource.data.status in ['new', 'confirmed'];
    }

    function customerEditProofOk() {
      return resource.data.trackKey is string
        && resource.data.trackKey.size() >= 16
        && request.resource.data.editProof == resource.data.trackKey;
    }

    function customerOrderEditKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'preferences', 'orderNotes', 'pickup',
          'editProof', 'updatedAt', 'statusUpdatedAt'
        ]);
    }

    function customerTrackEditKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly([
          'pickupDate', 'pickupSlot', 'preferences',
          'orderNotes', 'pickupNotes', 'updatedAt'
        ]);
    }

    function paymentFieldsTouched() {
      return request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'stripeCustomerId',
        'stripePaymentMethodId',
        'cardBrand',
        'cardLast4',
        'cardExpMonth',
        'cardExpYear',
        'paymentUpdatedAt'
      ]);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.name is string
        && !request.resource.data.keys().hasAny([
          'stripeCustomerId',
          'stripePaymentMethodId',
          'cardBrand',
          'cardLast4',
          'cardExpMonth',
          'cardExpYear'
        ]);
      // Stripe card fields are written only by Cloud Functions (Admin SDK).
      allow update: if isAdmin()
        || (isOwner(uid) && !paymentFieldsTouched());
      allow delete: if isAdmin();
    }

    function isApprovedManagerOnly() {
      return isSignedIn()
        && !isCompanyOwnerEmail(request.auth.token.email)
        && exists(/databases/$(database)/documents/staff/$(request.auth.uid))
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'approved'
        && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'manager';
    }

    function isStaffTargetOwner() {
      return resource.data.email is string
        && isCompanyOwnerEmail(resource.data.email);
    }

    function isStaffDirectoryReader() {
      return isSignedIn()
        && (
          isVerifiedCompanyOwner()
          || (
            exists(/databases/$(database)/documents/staff/$(request.auth.uid))
            && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.status == 'approved'
            && get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role in ['admin', 'manager']
          )
        );
    }

    match /staff/{uid} {
      // Owners/managers can list the full directory; anyone can read their own row.
      allow get: if isOwner(uid) || isStaffDirectoryReader();
      allow list: if isStaffDirectoryReader();

      // New applicants create their own pending row from /ops or /driver.
      allow create: if isOwner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 120
        && request.resource.data.role in ['admin', 'manager', 'driver']
        && request.resource.data.requestedPortal in ['ops', 'driver']
        && (
          request.resource.data.status == 'pending'
          || (
            request.resource.data.status == 'approved'
            && isVerifiedCompanyOwner()
          )
        );

      allow update: if (
        // Company owners can always heal/update their own staff doc
        (
          isOwner(uid)
          && isVerifiedCompanyOwner()
        )
        // Company owners may manage any non-owner staff (roles, approve, revoke)
        || (
          isVerifiedCompanyOwner()
          && !isStaffTargetOwner()
        )
        // Managers may approve/deny pending only as driver, or update drivers only
        || (
          isApprovedManagerOnly()
          && !isStaffTargetOwner()
          && request.resource.data.role == 'driver'
          && (
            (
              resource.data.status == 'pending'
              && request.resource.data.status in ['approved', 'denied', 'revoked']
            )
            || (
              resource.data.role == 'driver'
              && request.resource.data.role == 'driver'
            )
          )
        )
        // Regular staff may refresh name/email; pending applicants may also
        // bump requestedPortal when re-applying from /ops or /driver.
        || (
          isOwner(uid)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.status == resource.data.status
          && request.resource.data.role == resource.data.role
          && (
            (
              resource.data.status == 'pending'
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['email', 'displayName', 'updatedAt', 'requestedPortal'])
            )
            || (
              resource.data.status != 'pending'
              && request.resource.data.requestedPortal == resource.data.requestedPortal
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['email', 'displayName', 'updatedAt'])
            )
          )
        )
      );

      // Owners may delete any non-owner. Managers may delete drivers or any pending request (Deny).
      // Applicants may clear their own unfinished request so they can apply again.
      allow delete: if
        (
          isOwner(uid)
          && resource.data.status in ['pending', 'denied', 'revoked']
        )
        || (
          !isStaffTargetOwner()
          && (
            isVerifiedCompanyOwner()
            || (
              isApprovedManagerOnly()
              && (
                resource.data.role == 'driver'
                || resource.data.status == 'pending'
              )
            )
          )
        );
    }

    // Emails blocked from OPS/Driver access requests (spam).
    match /staffBanned/{emailId} {
      allow get: if isStaffDirectoryReader()
        || (
          isSignedIn()
          && request.auth.token.email is string
          && request.auth.token.email.lower() == emailId
        );
      allow list: if isStaffDirectoryReader();
      allow create, update: if isStaffDirectoryReader()
        && request.resource.data.email is string
        && request.resource.data.email == emailId
        && request.resource.data.bannedBy is string
        && request.resource.data.reason is string;
      allow delete: if isStaffDirectoryReader();
    }

    // Legacy driver docs — admin cleanup only
    match /drivers/{uid} {
      allow read, write, delete: if isAdmin();
    }

    match /contactMessages/{id} {
      allow create: if
        request.resource.data.keys().hasOnly([
          'name', 'email', 'phone', 'topic', 'message', 'createdAt', 'status', 'read'
        ])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() > 3
        && request.resource.data.email.size() <= 200
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.topic is string
        && request.resource.data.topic.size() <= 80
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 4000
        && request.resource.data.status == 'new'
        && request.resource.data.read == false
        && request.resource.data.createdAt == request.time;

      allow read, update, delete: if isAdmin();
    }

    // Stripe customer/payment-method metadata. Admin SDK only.
    // Customers, drivers, and OPS clients cannot read or write this collection.
    match /orderBilling/{orderId} {
      allow read, write: if false;
    }

    // Callable abuse counters. Admin SDK only.
    match /rateLimits/{bucket} {
      allow read, write: if false;
    }

    match /orders/{id} {
      // Guest checkout goes through createGuestOrder. A signed-out client cannot write an order.
      allow create: if
        request.resource.data.keys().hasOnly([
          'status', 'guest', 'uid', 'trackKey', 'services', 'contact',
          'pickup', 'preferences', 'orderNotes', 'pricing', 'tip', 'promoCode',
          'createdAt', 'sourceOrderId', 'automatedWeekly'
        ])
        && request.resource.data.status == 'new'
        && request.resource.data.guest is bool
        && request.resource.data.trackKey is string
        && request.resource.data.trackKey.size() >= 16
        && request.resource.data.trackKey.size() <= 64
        && request.resource.data.services is map
        && request.resource.data.services.laundry is bool
        && request.resource.data.services.dryCleaning is bool
        && request.resource.data.services.bagCount is int
        && request.resource.data.services.bagCount >= 0
        && request.resource.data.services.bagCount <= 100
        && request.resource.data.pickup is map
        && request.resource.data.pickup.date is string
        && request.resource.data.pickup.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.pickup.slot is string
        && request.resource.data.pickup.slot.size() > 0
        && request.resource.data.pickup.slot.size() <= 80
        && request.resource.data.pickup.repeat is bool
        && request.resource.data.preferences is map
        && request.resource.data.orderNotes is string
        && request.resource.data.orderNotes.size() <= 2000
        && orderPriceSnapshotMatches()
        && request.resource.data.createdAt == request.time
        && request.resource.data.contact.keys().hasAll(['name', 'email', 'phone'])
        && request.resource.data.contact.name is string
        && request.resource.data.contact.name.size() > 0
        && request.resource.data.contact.name.size() <= 120
        && request.resource.data.contact.email is string
        && request.resource.data.contact.email.size() > 3
        && request.resource.data.contact.email.size() <= 200
        && request.resource.data.contact.phone is string
        && request.resource.data.contact.phone.size() > 0
        && request.resource.data.contact.phone.size() <= 40
        && (
          isAdmin()
          || (request.resource.data.guest == false
            && isSignedIn()
            && request.resource.data.uid == request.auth.uid)
        );

      allow read: if isAdmin()
        || (
          isDriver()
          && 'assignedDriverUid' in resource.data
          && resource.data.assignedDriverUid == request.auth.uid
        )
        || (isSignedIn()
          && resource.data.uid is string
          && resource.data.uid == request.auth.uid);

      allow update: if isAdmin() || driverOrderUpdateAllowed() || (
        // Owner cancel
        isSignedIn()
        && resource.data.uid is string
        && resource.data.uid == request.auth.uid
        && orderWaitingStatus()
        && request.resource.data.status == 'cancelled'
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'statusUpdatedAt', 'cancelReason'])
      ) || (
        // Tracking-link edit (prefs / notes / reschedule) — editProof must match trackKey
        orderWaitingStatus()
        && request.resource.data.status == resource.data.status
        && customerEditProofOk()
        && customerOrderEditKeys()
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.guest == resource.data.guest
        && request.resource.data.trackKey == resource.data.trackKey
      );

      allow delete: if isAdmin() || (
        // Owner may hard-delete a waiting pickup (cancel = remove from system)
        isSignedIn()
        && resource.data.uid is string
        && resource.data.uid == request.auth.uid
        && resource.data.status in ['new', 'confirmed']
      );
    }

    match /orderTracks/{key} {
      // Secret URL key is the access control — get only (no list).
      allow get: if true;

      allow create: if
        key.size() >= 16
        && key.size() <= 64
        && request.resource.data.keys().hasOnly([
          'orderId', 'ref', 'status', 'firstName',
          'pickupDate', 'pickupSlot', 'laundry', 'dryCleaning',
          'bagCount', 'preferences', 'orderNotes', 'pickupNotes',
          'createdAt', 'updatedAt'
        ])
        && request.resource.data.orderId is string
        && request.resource.data.orderId.size() > 0
        && request.resource.data.orderId.size() <= 64
        && request.resource.data.ref is string
        && request.resource.data.ref.size() > 0
        && request.resource.data.ref.size() <= 16
        && request.resource.data.status == 'new'
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() <= 40
        && request.resource.data.pickupDate is string
        && request.resource.data.pickupSlot is string
        && request.resource.data.laundry is bool
        && request.resource.data.dryCleaning is bool
        && request.resource.data.bagCount is number
        && request.resource.data.preferences is map
        && request.resource.data.orderNotes is string
        && request.resource.data.orderNotes.size() <= 2000
        && request.resource.data.pickupNotes is string
        && request.resource.data.pickupNotes.size() <= 1000
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && orderTrackCreateMatchesOrder(key);

      allow update: if isAdmin() || (
        // Booking may replay the initial tracking document if the repair
        // trigger created it before the client write completed.
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderId', 'ref', 'status', 'firstName', 'pickupDate', 'pickupSlot',
          'laundry', 'dryCleaning', 'bagCount', 'preferences', 'orderNotes',
          'pickupNotes', 'createdAt', 'updatedAt'
        ])
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && orderTrackCreateMatchesOrder(key)
      ) || (
        resource.data.orderId is string
        && existsAfter(/databases/$(database)/documents/orders/$(resource.data.orderId))
        && orderTrackMatchesOrder(
          getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data
        )
        && isAssignedDriver(
          getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data
        )
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'photos', 'updatedAt'
        ])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['photos'])
          || (request.resource.data.photos is list
            && request.resource.data.photos.size() <= 30))
      ) || (
        resource.data.orderId is string
        && existsAfter(/databases/$(database)/documents/orders/$(resource.data.orderId))
        && orderTrackMatchesOrder(
          getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data
        )
        && isSignedIn()
        && getAfter(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.uid
          == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pickupDate', 'pickupSlot', 'preferences', 'orderNotes', 'pickupNotes', 'updatedAt'
        ])
      ) || (
        isSignedIn()
        && resource.data.orderId is string
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.uid
          == request.auth.uid
        && orderWaitingStatus()
        && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status', 'updatedAt'])
      ) || (
        // Anyone with the secret track key may edit requests / schedule
        orderWaitingStatus()
        && request.resource.data.status == resource.data.status
        && request.resource.data.orderId == resource.data.orderId
        && request.resource.data.ref == resource.data.ref
        && customerTrackEditKeys()
      );

      allow delete: if isAdmin() || (
        isSignedIn()
        && resource.data.orderId is string
        && exists(/databases/$(database)/documents/orders/$(resource.data.orderId))
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.uid
          == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(resource.data.orderId)).data.status
          in ['new', 'confirmed']
      );
    }

    match /promoCodes/{code} {
      // Customers validate a single code at booking; list/write is admin-only.
      allow get: if true;
      allow list, create, update, delete: if isAdmin();
    }

    match /pickupDayOverrides/{date} {
      allow read: if true;
      allow create, update, delete: if isAdmin()
        && date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    match /config/{docId} {
      allow read: if isAdmin() || docId == 'pickupSchedule' || docId == 'laundryRates' || docId == 'dryCleanCatalog';
      allow write: if isAdmin() && (
        (
          docId == 'dryCleanCatalog'
          && request.resource.data.keys().hasAll(['items'])
          && request.resource.data.items is list
          && request.resource.data.items.size() > 0
          && request.resource.data.items.size() <= 200
        )
        || (
          docId == 'pickupSchedule'
          && request.resource.data.keys().hasAll(['slots'])
          && request.resource.data.slots is list
          && request.resource.data.slots.size() > 0
          && request.resource.data.slots.size() <= 24
        )
        || (
          docId == 'laundryRates'
          && request.resource.data.keys().hasAll([
            'weeklyPerLb',
            'standardPerLb',
            'deliveryFee',
            'minimumOrder'
          ])
          && request.resource.data.weeklyPerLb is number
          && request.resource.data.standardPerLb is number
          && request.resource.data.deliveryFee is number
          && request.resource.data.minimumOrder is number
          && request.resource.data.weeklyPerLb > 0
          && request.resource.data.standardPerLb > 0
          && request.resource.data.deliveryFee > 0
          && request.resource.data.minimumOrder > 0
          && request.resource.data.weeklyPerLb < 100
          && request.resource.data.standardPerLb < 100
          && request.resource.data.deliveryFee < 100
          && request.resource.data.minimumOrder < 1000
        )
      );
    }

    match /pickupAvailability/{date} {
      allow read: if true;
      allow create, update: if isAdmin() &&
        date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && request.resource.data.keys().hasOnly(['slots', 'updatedAt'])
        && request.resource.data.slots is map;
      allow delete: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
