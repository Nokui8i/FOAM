<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ always draws a system splash (icon + bg).
      Use koala center crop — NOT the launcher F-OPS badge icon.
    -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splashSky</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_icon</item>
        <item name="windowSplashScreenAnimationDuration">0</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:statusBarColor">@color/splashSky</item>
        <item name="android:navigationBarColor">@color/splashSky</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowFullscreen">false</item>
    </style>
</resources>
