# Public Firebase client configuration for FOAM OPS (Expo).
# Copy to .env.local for local development. Do NOT put Admin/private secrets here.
#
# Native platforms must use platform Firebase API keys (NOT the Web Browser key).
# Android current_key ← google-services.json (package app.foam.ops)
# iOS API_KEY ← GoogleService-Info.plist (bundle app.foam.ops)

EXPO_PUBLIC_FIREBASE_ANDROID_API_KEY=
EXPO_PUBLIC_FIREBASE_IOS_API_KEY=

EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=foam-laundry-app.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=foam-laundry-app
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=foam-laundry-app.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=729229196646

# Shared Firebase *web* app ID for Firebase JS SDK Auth (matches FOAM web pattern).
# Native Google Sign-In still uses GoogleService-Info.plist / google-services.json.
EXPO_PUBLIC_FIREBASE_APP_ID=1:729229196646:web:044ef672c8f4c33e2c1ca7

# Shared Google Web OAuth client ID (public) for Google Sign-In → Firebase ID token.
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=729229196646-vfi3qchur2kggvp5gnerhn99mkiaoepr.apps.googleusercontent.com

# iOS OAuth client ID from GoogleService-Info.plist CLIENT_ID (native Google Sign-In).
EXPO_PUBLIC_FIREBASE_IOS_CLIENT_ID=

# Optional override of company-owner emails (public UX allowlist; rules remain authoritative).
# EXPO_PUBLIC_ADMIN_EMAILS=paylocksmith@gmail.com,iaaoamar12@gmail.com,liran4004@gmail.com
